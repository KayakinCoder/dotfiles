{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(terraform destroy*)",
      "Bash(tofu destroy*)",
      "Bash(terragrunt destroy*)",
      "Bash(terragrunt run-all destroy*)",
      "Bash(pulumi destroy*)",
      "Bash(cdk destroy*)",
      "Bash(terraform apply*)",
      "Bash(tofu apply*)",
      "Bash(terragrunt apply*)",
      "Bash(terragrunt run-all apply*)",
      "Bash(pulumi up*)",
      "Bash(cdk deploy*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -r *)",
      "Bash(aws s3 rb*)",
      "Bash(aws s3 rm*)",
      "Bash(az group delete*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Edit(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.tfstate)",
      "Edit(**/*.tfstate.*)",
      "Edit(**/.terraform.lock.hcl)",
      "Edit(**/.terraform/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_NEW_INIT": "1"
  },
  "enabledPlugins": {
    "aws-core@claude-plugins-official": true,
    "azure@claude-plugins-official": true,
    "buildkite@buildkite-skills": true,
    "pulumi-authoring@pulumi-agent-skills": true
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 300
  },
  "theme": "auto",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-destructive.sh\"",
            "timeout": 10,
            "statusMessage": "Checking command against destructive-command guardrail"
          }
        ]
      }
    ]
  }
}
